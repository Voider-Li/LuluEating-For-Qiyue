/* 主题变量统一放在 styles/theme.wxss（唯一来源，TabBar 也 import 它） */
@import "styles/theme.wxss";

page {
  background: var(--t-bg);
  color: var(--t-text);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  padding: 32rpx 32rpx 64rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--t-bg);
}

.card {
  background: var(--t-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(96, 86, 62, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: var(--t-text);
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 600;
  margin: 36rpx 4rpx 20rpx;
}

.section-sub {
  font-size: 24rpx;
  color: var(--t-text-sub);
  font-weight: 400;
}

.btn {
  border-radius: 20rpx;
  font-size: 30rpx;
  padding: 0 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--t-primary);
  color: var(--t-primary-ink);
}

.btn-primary[disabled] {
  background: #F0DEAE;
  color: #C2A562;
}

.btn-block {
  display: block;
  width: 100%;
  margin-top: 24rpx;
}

.btn-ghost {
  background: var(--t-chip);
  color: var(--t-primary-deep);
}

.input {
  background: var(--t-field);
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: none;
  width: 100%;
  box-sizing: border-box;
}

.muted {
  color: var(--t-text-sub);
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 64rpx 32rpx;
}

.empty-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 500;
}

.empty-sub {
  color: var(--t-text-sub);
  margin-top: 8rpx;
}

.hint {
  margin-top: 20rpx;
  text-align: center;
}

/* 自定义 tabBar 悬浮栏：给页面底部预留空间 */
.tab-page {
  padding-bottom: 240rpx;
  position: relative;
}

/* 底部环境光：让悬浮毛玻璃有内容可糊，增强真实感
   两层叠：中间一团暖光（被 Dock 糊开）+ 底部一条渐隐 */
.tab-page::after {
  content: '';
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 420rpx;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(120% 100% at 50% 118%, var(--t-glow-b) 0%, rgba(255, 246, 222, 0) 62%),
    linear-gradient(180deg, rgba(255, 246, 222, 0) 0%, var(--t-glow-a) 74%, var(--t-glow-b) 100%);
}
