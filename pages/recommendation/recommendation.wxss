.hero {
  padding: 40rpx 8rpx 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-sub {
  color: var(--t-text-sub);
  margin-top: 10rpx;
  font-size: 26rpx;
}

.result {
  margin-top: 36rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #C8860C;
}

.reason {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #5A564D;
}

.suggestions {
  margin-top: 24rpx;
}

.suggestion-chip {
  display: inline-block;
  background: #F7EED6;
  color: #8A6418;
  border-radius: 16rpx;
  padding: 16rpx 26rpx;
  font-size: 28rpx;
  margin: 0 14rpx 14rpx 0;
}

.summary {
  margin-top: 20rpx;
  font-size: 27rpx;
  color: var(--t-primary-deep);
}
