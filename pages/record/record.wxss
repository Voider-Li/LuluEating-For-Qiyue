.meal-row {
  display: flex;
  flex-wrap: wrap;
}

.meal-pill {
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: var(--t-field);
  color: var(--t-text-mid);
  font-size: 27rpx;
  margin: 0 16rpx 16rpx 0;
}

.meal-pill-active {
  background: var(--t-primary);
  color: var(--t-primary-ink);
}

.image-picker {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--t-field);
  min-height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview {
  width: 100%;
  height: 440rpx;
  display: block;
}

.picker-placeholder {
  text-align: center;
}

.picker-emoji {
  font-size: 80rpx;
}

.picker-text {
  color: var(--t-text-sub);
  margin-top: 12rpx;
}

.scan-wrap {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

.scan-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(30, 24, 10, 0.3);
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, rgba(255, 182, 39, 0), var(--t-primary) 50%, rgba(255, 182, 39, 0));
  box-shadow: 0 0 24rpx rgba(255, 182, 39, 0.9);
  animation: scanMove 1.8s ease-in-out infinite;
}

@keyframes scanMove {
  0% {
    top: 6%;
  }
  50% {
    top: 94%;
  }
  100% {
    top: 6%;
  }
}

.scan-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(255, 253, 247, 0.92);
  color: var(--t-primary-deep);
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.analyze-panel {
  margin-top: 24rpx;
  background: var(--t-card);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(96, 86, 62, 0.05);
}

.step-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.step-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #E2DCCB;
  color: var(--t-primary-deep);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.step-active {
  border-color: var(--t-primary);
  background: var(--t-primary);
  color: var(--t-primary-ink);
}

.step-done {
  border-color: #FFE9B8;
  background: #FFE9B8;
}

.step-name {
  margin-left: 14rpx;
  font-size: 26rpx;
  color: var(--t-text-sub);
}

.step-name-active {
  color: var(--t-primary-deep);
  font-weight: 600;
}

.step-percent {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--t-primary);
  font-weight: 600;
}

.bar {
  height: 12rpx;
  background: var(--t-field);
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFD76A, var(--t-primary));
  transition: width 0.35s ease;
}

.result-card {
  margin-top: 32rpx;
}

.foods-editor {
  margin-bottom: 8rpx;
}

.food-chip {
  display: inline-flex;
  align-items: center;
  background: var(--t-chip);
  color: var(--t-primary-deep);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin: 0 12rpx 16rpx 0;
  font-size: 26rpx;
}

.chip-name {
  font-size: 26rpx;
}

.chip-kcal {
  margin-left: 10rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.chip-remove {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #C25B3F;
}

.add-food-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.add-food-input {
  flex: 1;
}

.add-food-btn {
  margin-left: 16rpx;
  background: var(--t-primary);
  color: var(--t-primary-ink);
  font-size: 26rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
}

.note-card { margin-top: 26rpx; padding: 26rpx; border-radius: 22rpx; background: #FFF8E7; border: 1rpx solid #F4E4BC; }
.note-card-title { display: flex; align-items: center; justify-content: space-between; color: #645333; font-size: 29rpx; font-weight: 600; }
.note-card-hint { color: #B9A979; font-size: 22rpx; font-weight: 400; }
.note-input { width: 100%; height: 150rpx; box-sizing: border-box; padding: 18rpx 0 0; line-height: 1.55; font-size: 26rpx; color: #5B5548; }


/* Visual polish additions */
.record-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 190rpx;
  margin: 18rpx 0 24rpx;
  padding: 28rpx 28rpx 26rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFF9E8 0%, #FFF0C9 58%, #F6E1B3 100%);
  box-shadow: 0 12rpx 26rpx rgba(155, 118, 42, 0.11);
}

.record-hero-copy {
  position: relative;
  z-index: 1;
  max-width: 560rpx;
}

.eyebrow {
  color: #B07A20;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1.5rpx;
}

.record-hero-title {
  margin-top: 12rpx;
  color: #51432B;
  font-size: 39rpx;
  font-weight: 700;
  line-height: 1.22;
}

.record-hero-sub {
  margin-top: 12rpx;
  color: #8C7650;
  font-size: 23rpx;
  line-height: 1.55;
}

.record-hero-mark {
  flex-shrink: 0;
  margin: 0 8rpx 4rpx 18rpx;
  font-size: 76rpx;
  line-height: 1;
  transform: rotate(-7deg);
  filter: drop-shadow(0 8rpx 8rpx rgba(137, 98, 27, 0.12));
}

.card-subtitle {
  margin-top: -13rpx;
  margin-bottom: 22rpx;
  color: #A29A8A;
  font-size: 22rpx;
  line-height: 1.45;
}

.meal-row {
  gap: 12rpx;
  padding: 6rpx;
  border-radius: 22rpx;
  background: #FAF6EC;
}

.meal-pill {
  flex: 1;
  min-width: 124rpx;
  margin: 0;
  padding: 17rpx 18rpx;
  box-sizing: border-box;
  text-align: center;
  transition: transform 0.15s ease, background 0.15s ease;
}

.meal-pill-active {
  box-shadow: 0 7rpx 15rpx rgba(245, 163, 18, 0.2);
  transform: translateY(-2rpx);
}

.image-picker {
  min-height: 390rpx;
  border: 1rpx dashed #E6D6B6;
  box-shadow: inset 0 0 0 8rpx rgba(255, 255, 255, 0.18);
}

.picker-tip {
  margin-top: 10rpx;
  color: #B2A58E;
  font-size: 21rpx;
}

.analyze-button {
  margin-top: 26rpx;
  box-shadow: 0 10rpx 20rpx rgba(245, 163, 18, 0.2);
}

.result-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.result-heading .card-title {
  margin-bottom: 22rpx;
}

.result-heading .card-subtitle {
  margin-bottom: 20rpx;
}

.result-badge {
  flex-shrink: 0;
  margin: 2rpx 0 0 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #5A7B51;
  background: #E7F1E1;
  font-size: 20rpx;
}
