/* ============================================================
   记录页
   布局节奏：页头 → 01 餐次 → 02 拍照 → 03 确认
   每一块都有编号 + 标题，滚动时能一眼看出自己在哪一步
   ============================================================ */

.record-page {
  padding-bottom: 260rpx;
}

/* ---------- 页头 ---------- */
.rec-head {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 18rpx 0 30rpx;
  padding: 30rpx 28rpx 28rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFF9E8 0%, #FFF0C9 58%, #F6E1B3 100%);
  box-shadow: 0 12rpx 26rpx rgba(155, 118, 42, 0.11);
}

.rec-head-copy {
  position: relative;
  z-index: 1;
  max-width: 540rpx;
}

.eyebrow {
  color: #B07A20;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1.5rpx;
}

.rec-head-title {
  margin-top: 12rpx;
  color: #51432B;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.24;
}

.rec-head-sub {
  margin-top: 12rpx;
  color: #8C7650;
  font-size: 23rpx;
  line-height: 1.55;
}

.rec-head-mark {
  flex-shrink: 0;
  margin: 0 6rpx 2rpx 16rpx;
  font-size: 74rpx;
  line-height: 1;
  transform: rotate(-7deg);
  filter: drop-shadow(0 8rpx 8rpx rgba(137, 98, 27, 0.12));
}

/* ---------- 分块标题 ---------- */
.block {
  margin-bottom: 30rpx;
}

.block-head {
  display: flex;
  align-items: center;
  margin: 0 6rpx 16rpx;
}

.block-no {
  padding: 3rpx 10rpx;
  border-radius: 10rpx;
  background: #FFF0CB;
  color: #B58A42;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.block-title {
  margin-left: 12rpx;
  color: #4A4438;
  font-size: 30rpx;
  font-weight: 600;
}

.block-meta {
  margin-left: auto;
  color: #A79C86;
  font-size: 22rpx;
}

/* ---------- 01 餐次 ---------- */
.meal-row {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  border: 1rpx solid #F2E6CC;
  border-radius: 26rpx;
  background: rgba(255, 253, 247, 0.78);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.meal-pill {
  flex: 1;
  height: 106rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #9B968A;
  transition: background 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}

.meal-emoji {
  font-size: 32rpx;
  line-height: 1;
  opacity: 0.72;
}

.meal-label {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1;
}

.meal-pill-active {
  background: linear-gradient(180deg, #FFD87C 0%, #FFB627 100%);
  box-shadow: 0 8rpx 18rpx rgba(245, 163, 18, 0.26), inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  transform: translateY(-2rpx);
}

.meal-pill-active .meal-emoji {
  opacity: 1;
}

.meal-pill-active .meal-label {
  color: #5C4305;
  font-weight: 600;
}

.meal-hint {
  margin: 14rpx 8rpx 0;
  color: #A79C86;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ---------- 02 拍照 ---------- */
.shot-card {
  position: relative;
  min-height: 380rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  border: 2rpx dashed #E7D6B4;
  border-radius: 28rpx;
  background: linear-gradient(160deg, #FFFDF7 0%, #FBF3E2 100%);
}

.shot-card-filled {
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.9);
  background: #EFE7D5;
  box-shadow: 0 10rpx 24rpx rgba(96, 86, 62, 0.12);
}

.shot-img {
  width: 100%;
  height: 440rpx;
  display: block;
}

.shot-empty {
  padding: 44rpx 0;
  text-align: center;
}

.shot-glyph {
  position: relative;
  width: 124rpx;
  height: 124rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  background: linear-gradient(160deg, #FFF4D8 0%, #FFE5AF 100%);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.9), 0 12rpx 22rpx rgba(190, 142, 45, 0.16);
}

.shot-glyph-ring {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 38rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}

.shot-glyph-icon {
  font-size: 52rpx;
  line-height: 1;
}

.shot-main {
  margin-top: 22rpx;
  color: #6B5A38;
  font-size: 28rpx;
  font-weight: 600;
}

.shot-sub {
  margin-top: 8rpx;
  color: #A99C82;
  font-size: 22rpx;
}

.shot-retake {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.92);
  color: #7A6231;
  font-size: 21rpx;
  box-shadow: 0 4rpx 12rpx rgba(96, 86, 62, 0.16);
}

/* 扫描动画 */
.scan-wrap {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

.scan-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(30, 24, 10, 0.28);
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, rgba(255, 182, 39, 0), var(--t-primary) 50%, rgba(255, 182, 39, 0));
  box-shadow: 0 0 24rpx rgba(255, 182, 39, 0.9);
  animation: scanMove 1.8s ease-in-out infinite;
}

@keyframes scanMove {
  0% {
    top: 6%;
  }
  50% {
    top: 94%;
  }
  100% {
    top: 6%;
  }
}

.scan-badge {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.94);
  color: var(--t-primary-deep);
  font-size: 24rpx;
}

.analyze-button {
  margin-top: 22rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(245, 163, 18, 0.22);
}

/* 识别进度 */
.analyze-panel {
  margin-top: 20rpx;
  padding: 26rpx 26rpx 22rpx;
  border: 1rpx solid #F2E7D0;
  border-radius: 24rpx;
  background: rgba(255, 253, 247, 0.92);
  box-shadow: 0 6rpx 16rpx rgba(96, 86, 62, 0.05);
}

.step-track {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.step-node {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-node:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 50%;
  width: 100%;
  height: 2rpx;
  background: #EFE4CD;
}

.step-dot {
  position: relative;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #EADFC8;
  border-radius: 50%;
  background: #FFFDF7;
  color: #B9AC92;
  font-size: 20rpx;
}

.step-active {
  border-color: var(--t-primary);
  background: var(--t-primary);
  color: #5C4305;
  font-weight: 700;
  box-shadow: 0 0 0 6rpx rgba(255, 182, 39, 0.16);
}

.step-done {
  border-color: #FFE0A0;
  background: #FFE9B8;
  color: #B57D0A;
}

.step-name {
  margin-top: 10rpx;
  color: #A79C86;
  font-size: 21rpx;
}

.step-name-active {
  color: var(--t-primary-deep);
  font-weight: 600;
}

.bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: #F1E8D6;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFD76A, var(--t-primary));
  transition: width 0.35s ease;
}

.analyze-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #9B968A;
  font-size: 21rpx;
}

.step-percent {
  color: var(--t-primary);
  font-weight: 600;
}

/* ---------- 03 确认 ---------- */
.result-card {
  margin-bottom: 0;
  padding: 28rpx;
  border-radius: 26rpx;
  background: var(--t-card);
  box-shadow: 0 8rpx 22rpx rgba(96, 86, 62, 0.07);
}

.foods-editor {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.food-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border: 1rpx solid #F6E3B7;
  border-radius: 999rpx;
  background: #FFF4D9;
  color: #7A5B12;
  font-size: 25rpx;
}

.chip-name {
  font-size: 25rpx;
  line-height: 1.3;
}

.chip-kcal {
  margin-left: 8rpx;
  color: #A98B4A;
  font-size: 20rpx;
}

.chip-remove {
  width: 32rpx;
  height: 32rpx;
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(194, 91, 63, 0.12);
  color: #C25B3F;
  font-size: 24rpx;
  line-height: 1;
}

.add-food-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.add-food-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 18rpx;
  background: #F6F1E6;
  font-size: 25rpx;
}

.add-food-btn {
  flex-shrink: 0;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: #FFF0CB;
  color: #8A6A1E;
  font-size: 25rpx;
  font-weight: 600;
}

.result-divider {
  height: 1rpx;
  margin: 26rpx 0 22rpx;
  background: linear-gradient(90deg, rgba(239, 230, 212, 0), #EFE6D4 20%, #EFE6D4 80%, rgba(239, 230, 212, 0));
}

.note-card {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #F4E4BC;
  border-radius: 20rpx;
  background: #FFF8E7;
}

.note-card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #645333;
  font-size: 27rpx;
  font-weight: 600;
}

.note-card-hint {
  color: #B9A979;
  font-size: 21rpx;
  font-weight: 400;
}

.note-input {
  width: 100%;
  height: 140rpx;
  box-sizing: border-box;
  padding: 16rpx 0 0;
  color: #5B5548;
  font-size: 26rpx;
  line-height: 1.55;
}

.save-btn {
  margin-top: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(245, 163, 18, 0.26);
}
