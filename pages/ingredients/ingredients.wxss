/* ============================================================
   食材页
   布局：页头（含数量） → 一行式添加 → 常吃快选 → 清单
   ============================================================ */

/* ---------- 页头 ---------- */
.ing-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0 28rpx;
  padding: 28rpx 26rpx 28rpx 28rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 30rpx;
  background: linear-gradient(135deg, #F2F7EC 0%, #E6F1DE 58%, #D9E8CE 100%);
  box-shadow: 0 12rpx 26rpx rgba(83, 112, 75, 0.1);
}

.ing-head-copy {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.eyebrow {
  color: #7E9468;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1.5rpx;
}

.ing-head-title {
  margin-top: 12rpx;
  color: #40563A;
  font-size: 37rpx;
  font-weight: 700;
  line-height: 1.25;
}

.ing-head-sub {
  margin-top: 10rpx;
  color: #6E8566;
  font-size: 22rpx;
}

.ing-count {
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx dashed rgba(122, 152, 106, 0.5);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.62);
}

.ing-count-num {
  color: #4F6B46;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.ing-count-label {
  margin-top: 6rpx;
  color: #7E9468;
  font-size: 19rpx;
  line-height: 1;
}

/* ---------- 添加 ---------- */
.add-card {
  margin-bottom: 32rpx;
  padding: 22rpx;
  border: 1rpx solid #F1E7D2;
  border-radius: 26rpx;
  background: var(--t-card);
  box-shadow: 0 8rpx 20rpx rgba(96, 86, 62, 0.06);
}

.add-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.add-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #F6F1E6;
  color: var(--t-text-body);
  font-size: 27rpx;
}

.add-submit {
  flex-shrink: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 30rpx;
  border-radius: 18rpx;
  background: #F1ECDF;
  color: #A79C86;
  font-size: 27rpx;
  font-weight: 600;
  transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
}

.add-submit-on {
  background: var(--t-primary);
  color: var(--t-primary-ink);
  box-shadow: 0 8rpx 18rpx rgba(245, 163, 18, 0.24);
}

.add-extra {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.add-mini {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #FAF6EC;
  color: var(--t-text-mid);
  font-size: 24rpx;
}

.quick-row {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F5EEDF;
}

.quick-label {
  flex-shrink: 0;
  margin: 8rpx 14rpx 0 2rpx;
  color: #B3A791;
  font-size: 21rpx;
}

.quick-chips {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.quick-chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #F3F7EE;
  color: #66805C;
  font-size: 22rpx;
}

/* ---------- 清单 ---------- */
.list-block {
  margin-bottom: 30rpx;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 6rpx 14rpx;
}

.list-title {
  color: #4A4438;
  font-size: 30rpx;
  font-weight: 600;
}

.list-meta {
  color: #A79C86;
  font-size: 22rpx;
}

.list-card {
  padding: 6rpx 26rpx;
  border: 1rpx solid #F1E7D2;
  border-radius: 26rpx;
  background: var(--t-card);
  box-shadow: 0 8rpx 20rpx rgba(96, 86, 62, 0.06);
}

.list-row {
  border-bottom: 1rpx solid #F5EEDF;
}

.list-row:last-child {
  border-bottom: none;
}

.ing-loading {
  padding: 40rpx 0;
  color: var(--t-text-sub);
  font-size: 24rpx;
  text-align: center;
}

.ing-empty {
  padding: 44rpx 24rpx 40rpx;
  text-align: center;
}

.ing-empty-icon {
  font-size: 64rpx;
  line-height: 1;
}

.ing-empty-title {
  margin-top: 16rpx;
  color: #5A574E;
  font-size: 28rpx;
  font-weight: 600;
}

.ing-empty-copy {
  margin-top: 8rpx;
  color: #A29A8A;
  font-size: 22rpx;
  line-height: 1.5;
}
