.field {
  margin-bottom: 20rpx;
}

.field-row {
  display: flex;
}

.field-half {
  flex: 1;
  min-width: 0;
}

.field-half + .field-half {
  margin-left: 20rpx;
}


/* Visual polish additions */
.ingredients-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 190rpx;
  margin: 18rpx 0 24rpx;
  padding: 28rpx 28rpx 26rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 30rpx;
  background: linear-gradient(135deg, #F0F5E8 0%, #E5F0DE 56%, #D7E6CC 100%);
  box-shadow: 0 12rpx 26rpx rgba(83, 112, 75, 0.1);
}

.ingredients-hero-copy {
  max-width: 535rpx;
}

.ingredients-hero-title {
  margin-top: 12rpx;
  color: #43583D;
  font-size: 37rpx;
  font-weight: 700;
  line-height: 1.25;
}

.ingredients-hero-sub {
  margin-top: 12rpx;
  color: #6E8566;
  font-size: 23rpx;
}

.ingredients-count {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-left: 18rpx;
  border-radius: 32rpx;
  background: rgba(255, 253, 247, 0.65);
  color: #58734F;
}

.ingredients-count-number {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.ingredients-count-label {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.field-label {
  margin: 0 0 8rpx 4rpx;
  color: #827A69;
  font-size: 22rpx;
}

.ingredients-hero + .card .card-subtitle {
  margin-bottom: 24rpx;
}

.inventory-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.inventory-heading .card-title {
  margin-bottom: 22rpx;
}

.inventory-heading .card-subtitle {
  margin-bottom: 24rpx;
}

.inventory-total {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  background: #EAF3E5;
  color: #55734E;
  font-size: 24rpx;
  font-weight: 700;
}

.ingredient-loading {
  padding: 30rpx 0 12rpx;
  color: var(--t-text-sub);
  font-size: 24rpx;
  text-align: center;
}

.ingredient-empty {
  padding: 28rpx 24rpx 14rpx;
  border-radius: 22rpx;
  background: #FAF8F0;
  text-align: center;
}

.ingredient-empty-icon {
  font-size: 60rpx;
  line-height: 1;
}

.ingredient-empty-title {
  margin-top: 14rpx;
  color: #5A574E;
  font-size: 28rpx;
  font-weight: 600;
}

.ingredient-empty-copy {
  margin-top: 8rpx;
  color: #A29A8A;
  font-size: 22rpx;
  line-height: 1.5;
}
