<view class="page theme-{{theme}} tab-page ingredients-page">
  <custom-nav-bar />

  <!-- 页头 -->
  <view class="ing-head">
    <view class="ing-head-copy">
      <view class="eyebrow">PANTRY NOTES · 家里的小库存</view>
      <view class="ing-head-title">记下手边的食材，下一餐就有方向</view>
      <view class="ing-head-sub">不用一次整理完，想到什么就添什么。</view>
    </view>
    <view class="ing-count">
      <text class="ing-count-num">{{list.length}}</text>
      <text class="ing-count-label">种</text>
    </view>
  </view>

  <!-- 添加食材 -->
  <view class="add-card">
    <view class="add-row">
      <input
        class="add-input"
        placeholder="食材名称，如：鸡蛋"
        value="{{name}}"
        bindinput="onNameInput"
        confirm-type="done"
        bindconfirm="onAdd"
      />
      <view class="add-submit {{name ? 'add-submit-on' : ''}}" bindtap="onAdd">{{adding ? '添加中' : '添加'}}</view>
    </view>

    <view class="add-extra">
      <input class="add-mini" placeholder="数量（可选）" value="{{quantity}}" bindinput="onQuantityInput" />
      <input class="add-mini" placeholder="备注（可选）" value="{{note}}" bindinput="onNoteInput" />
    </view>

    <view class="quick-row">
      <text class="quick-label">常吃</text>
      <view class="quick-chips">
        <view
          class="quick-chip"
          wx:for="{{quickList}}"
          wx:key="*this"
          data-name="{{item}}"
          bindtap="onQuickTap"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 食材列表 -->
  <view class="list-block">
    <view class="list-head">
      <text class="list-title">家里有什么</text>
      <text class="list-meta">{{list.length ? '共 ' + list.length + ' 项' : '还空着'}}</text>
    </view>

    <view class="list-card">
      <view class="ing-loading" wx:if="{{loading}}">正在整理食材清单…</view>

      <block wx:elif="{{list.length}}">
        <view class="list-row" wx:for="{{list}}" wx:key="id">
          <ingredient-item ingredient="{{item}}" bind:delete="onDelete" />
        </view>
      </block>

      <view class="ing-empty" wx:else>
        <view class="ing-empty-icon">🧺</view>
        <view class="ing-empty-title">冰箱还在等第一条记录</view>
        <view class="ing-empty-copy">从上面添一项，慢慢把你们的厨房收集起来。</view>
      </view>
    </view>
  </view>
</view>
