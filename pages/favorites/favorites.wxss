.favorites-page { padding-bottom: 80rpx; }
.favorites-hero { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 6rpx 30rpx; }
.eyebrow { font-size: 20rpx; letter-spacing: 3rpx; color: var(--t-accent); font-weight: 600; }
.page-title { color: var(--t-text-strong); font-size: 48rpx; font-weight: 700; margin-top: 4rpx; }
.page-subtitle { color: var(--t-text-sub); font-size: 24rpx; margin-top: 4rpx; }
.hero-emoji { width: 116rpx; height: 116rpx; display: flex; align-items: center; justify-content: center; border-radius: 40% 60% 52% 48%; background: #FFE5AE; font-size: 64rpx; transform: rotate(8deg); }
.collection-meta { display: flex; justify-content: space-between; align-items: center; color: #A29A8A; font-size: 24rpx; margin: 0 4rpx 20rpx; }
.meta-number { color: var(--t-primary-deep); font-size: 30rpx; font-weight: 700; }
.add-favorite { padding: 11rpx 18rpx; border-radius: 999rpx; background: #FFF0C8; color: #A46F0A; }
.favorite-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.favorite-card { position: relative; min-height: 290rpx; padding: 26rpx 22rpx 22rpx; box-sizing: border-box; border-radius: 24rpx; background: var(--t-card); box-shadow: 0 6rpx 18rpx rgba(96, 86, 62, .06); }
.favorite-card:nth-child(3n) { background: #F1F6ED; }
.favorite-card:nth-child(3n+2) { background: #FFF2E3; }
.favorite-art { font-size: 66rpx; margin-bottom: 16rpx; }
.favorite-art-img { display: block; width: 100%; height: 170rpx; border-radius: 16rpx; margin-bottom: 16rpx; background: var(--t-holder); }
.favorite-name { color: #514C42; font-size: 29rpx; font-weight: 600; }
.favorite-note { color: #8A8376; font-size: 22rpx; line-height: 1.45; margin-top: 6rpx; }
.favorite-hint { position: absolute; right: 18rpx; bottom: 18rpx; color: #C4B9A4; font-size: 19rpx; }
