/* ===== 我们的餐桌 ===== */

.table-page {
  background: #FFF8E9;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 头部 ---------- */
.t-head {
  padding: 24rpx 4rpx 2rpx;
}

.t-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.t-title-wrap {
  position: relative;
  display: inline-flex;
}

.t-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #B8791A;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, .9), 0 8rpx 20rpx rgba(217, 125, 10, .18);
}

/* 标题两侧的暖色细枝 + 光点 */
.t-orn {
  position: relative;
  width: 92rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(255, 182, 39, 0) 0%, rgba(255, 182, 39, .7) 100%);
}

.t-orn::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -3rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FFC453;
  transform: translateY(-50%);
  box-shadow: 0 0 12rpx rgba(255, 182, 39, .75);
}

.t-orn-r {
  transform: scaleX(-1);
}

.t-dot {
  position: absolute;
  top: -6rpx;
  right: -22rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #E24B4A;
  box-shadow: 0 0 10rpx rgba(226, 75, 74, .5);
}

.t-sub {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B7A36D;
  letter-spacing: 2rpx;
}

/* ---------- 餐桌舞台 ---------- */
.stage {
  position: relative;
  margin: 78rpx 0 104rpx;
}

.stage-table {
  display: block;
  width: 100%;
}

/* ---------- 两个人的座位 ---------- */
.seat {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 3;
}

.seat-face {
  display: block;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 5rpx solid #FFFDF7;
  box-sizing: border-box;
  background: #FFFDF7;
  box-shadow: 0 8rpx 20rpx rgba(116, 91, 42, .18);
}

.seat-face-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 600;
}

.seat-name {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6E6655;
  white-space: nowrap;
}

/* ---------- 桌上的六道菜 ---------- */
.plate {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: #FFFDF7;
  border: 3rpx solid #E8D6AE;
  box-shadow: 0 4rpx 12rpx rgba(116, 91, 42, .10);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  z-index: 2;
}

/* 有照片：缩略图铺满 */
.plate-has-photo {
  border-color: #FFFDF7;
  background: #F0E6D2;
  box-shadow: 0 6rpx 16rpx rgba(116, 91, 42, .16);
}

/* 没有照片：浅色虚线，中间写「早饭 / 午饭 / 晚饭」 */
.plate-empty {
  background: rgba(255, 253, 247, .45);
  border-style: dashed;
  border-color: #D8CBAE;
  box-shadow: none;
}

.plate-photo {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.plate-meal {
  font-size: 24rpx;
  line-height: 1.2;
  color: #A79C86;
}

.plate-meal-sm {
  font-size: 19rpx;
  color: #BDB29A;
}

.plate-foods {
  max-width: 100%;
  margin-top: 2rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  font-size: 21rpx;
  line-height: 1.2;
  color: #6E6655;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 三个小伙伴 ---------- */
.mate {
  position: absolute;
  transform: translate(-50%, -50%);
  transition: transform .18s ease;
  z-index: 4;
}

.mate-up {
  transform: translate(-50%, -50%) scale(1.14);
}

.mate-face {
  display: block;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 5rpx solid #FFFDF7;
  box-sizing: border-box;
  background: #FFFDF7;
  box-shadow: 0 8rpx 18rpx rgba(116, 91, 42, .18);
}

.mate-face-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

.mate-name {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #857C69;
  white-space: nowrap;
}

/* ---------- 说话气泡 ---------- */
.bubble {
  display: flex;
  align-items: flex-start;
  margin: 0 4rpx 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFDF7;
  border: 2rpx solid #F0E2C4;
  box-shadow: 0 8rpx 20rpx rgba(116, 91, 42, .08);
}

.bubble-face {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #F4E7C5;
}

.bubble-face-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8A5A12;
}

.bubble-body {
  flex: 1;
  min-width: 0;
}

.bubble-name {
  font-size: 21rpx;
  color: #A79C86;
}

.bubble-text {
  margin-top: 2rpx;
  font-size: 27rpx;
  line-height: 1.55;
  color: #4D473C;
}

/* 还在想的时候：文字淡一点 + 三个跳动的点 */
.bubble-thinking .bubble-text {
  color: #A79C86;
}

.bubble-dots {
  display: flex;
  gap: 8rpx;
  margin-top: 10rpx;
}

.bubble-dots .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #D8CBAE;
  animation: dotPulse 1.1s ease-in-out infinite;
}

.bubble-dots .dot:nth-child(2) { animation-delay: 0.18s; }
.bubble-dots .dot:nth-child(3) { animation-delay: 0.36s; }

@keyframes dotPulse {
  0%, 100% { opacity: 0.3; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-4rpx); }
}

/* ---------- 记一餐 ---------- */
.record-btn {
  margin-top: auto;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #FFB627;
  color: #5C4305;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 26rpx rgba(217, 125, 10, .24);
}

.record-btn:active {
  background: #F0A80F;
}

/* ---------- 后厨送出来的惊喜 ---------- */
.surprise {
  margin: 0 4rpx 20rpx;
}

.surprise-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 12rpx;
  border-radius: 22rpx;
  background: #FFF6DE;
  border: 2rpx dashed #E8C87A;
}

.surprise-tag {
  flex: 0 0 auto;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #FFB627;
  color: #5C4305;
  font-size: 20rpx;
}

.surprise-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.5;
  color: #6B5A34;
}

.surprise-done {
  flex: 0 0 auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #FFFDF7;
  color: #B57D0A;
  font-size: 22rpx;
}

/* ---------- 后厨面板 ---------- */
.bs-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1500;
  background: rgba(60, 48, 28, .42);
}

.bs-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1600;
  max-height: 80vh;
  padding: 32rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFDF7;
  box-shadow: 0 -12rpx 40rpx rgba(92, 67, 31, .2);
  transform: translateY(110%);
  transition: transform .22s ease;
  overflow-y: auto;
}

.bs-sheet-show {
  transform: translateY(0);
}

.bs-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.bs-eyebrow {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #B7A36D;
}

.bs-title {
  margin-top: 2rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #413D35;
}

.bs-close {
  padding: 4rpx 16rpx;
  font-size: 44rpx;
  line-height: 1;
  color: #B8A992;
}

.bs-input {
  width: 100%;
  height: 140rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #FFF8E9;
  font-size: 27rpx;
  color: #4D473C;
}

.bs-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.bs-label {
  flex: 0 0 auto;
  width: 170rpx;
  font-size: 24rpx;
  color: #8B8474;
}

.bs-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.bs-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #FFF3D6;
  color: #8B6A35;
  font-size: 24rpx;
}

.bs-chip-on {
  background: #FFB627;
  color: #5C4305;
  font-weight: 600;
}

.bs-save {
  margin-top: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #FFB627;
  color: #5C4305;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.bs-list {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0E6D2;
}

.bs-list-title {
  font-size: 23rpx;
  color: #A79C86;
  margin-bottom: 14rpx;
}

.bs-list-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.bs-list-main {
  flex: 1;
  min-width: 0;
}

.bs-list-text {
  font-size: 26rpx;
  color: #4D473C;
}

.bs-list-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #A79C86;
}

.bs-list-del {
  flex: 0 0 auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #F7F3EA;
  color: #A79C86;
  font-size: 22rpx;
}
