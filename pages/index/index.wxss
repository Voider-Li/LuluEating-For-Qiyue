.home-page { overflow-x: hidden; }

.home-intro { display: flex; align-items: flex-end; justify-content: space-between; margin: 20rpx 4rpx 22rpx; }
.eyebrow, .section-label, .hero-kicker, .menu-eyebrow { color: #A39884; font-size: 19rpx; letter-spacing: 2rpx; text-transform: uppercase; }
.eyebrow text { letter-spacing: 0; margin-left: 8rpx; }
.home-title { margin-top: 10rpx; font-size: 48rpx; line-height: 1.15; font-weight: 700; color: #38352F; letter-spacing: -1rpx; }
.home-subtitle { margin-top: 10rpx; color: #8E887B; font-size: 24rpx; }
.identity-pill { display: flex; align-items: center; gap: 8rpx; padding: 10rpx 16rpx; border: 1rpx solid #EFE1C5; border-radius: 999rpx; background: rgba(255,253,247,.72); color: #88754E; font-size: 22rpx; }
.identity-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #7AAE72; box-shadow: 0 0 0 5rpx #E2F0DE; }

.hero-card { position: relative; min-height: 300rpx; overflow: hidden; display: flex; align-items: stretch; margin: 0 -4rpx 24rpx; padding: 34rpx 0 26rpx 32rpx; border-radius: 32rpx; background: linear-gradient(125deg, #FFF8E6 0%, #FFF1CA 60%, #FFE1A4 100%); box-shadow: 0 16rpx 30rpx rgba(190, 142, 45, .14); }
.hero-copy { position: relative; z-index: 2; width: 60%; display: flex; flex-direction: column; align-items: flex-start; }
.hero-kicker { color: #B58A42; }
.hero-title { margin-top: 12rpx; font-size: 39rpx; font-weight: 700; color: #59461F; line-height: 1.2; }
.hero-sub { margin-top: 14rpx; width: 360rpx; color: #8C7443; font-size: 23rpx; line-height: 1.55; }
.hero-actions { margin-top: auto; display: flex; align-items: center; gap: 24rpx; }
.hero-btn { display: flex; align-items: center; justify-content: center; width: 220rpx; height: 70rpx; border-radius: 999rpx; background: var(--t-primary); color: var(--t-primary-ink); font-size: 25rpx; font-weight: 600; box-shadow: 0 8rpx 18rpx rgba(210, 145, 23, .24); }
.hero-btn-hover { transform: scale(.96); }
.hero-text-btn { color: #8A6D31; font-size: 23rpx; }
.hero-text-btn text { font-size: 34rpx; vertical-align: -2rpx; margin-left: 4rpx; }
.hero-ttl { position: absolute; right: -14rpx; bottom: -18rpx; z-index: 1; width: 310rpx; opacity: .92; filter: drop-shadow(0 14rpx 12rpx rgba(155, 113, 29, .13)); }
.hero-sticker { position: absolute; right: 24rpx; top: 24rpx; z-index: 3; padding: 8rpx 14rpx; color: #A76A22; font-size: 18rpx; background: rgba(255,255,255,.54); border-radius: 12rpx 12rpx 12rpx 2rpx; transform: rotate(5deg); }

.status-card { padding: 28rpx 30rpx 24rpx; margin-bottom: 28rpx; border: 1rpx solid #F0E4CB; border-radius: 26rpx; background: rgba(255,253,247,.86); box-shadow: 0 8rpx 20rpx rgba(96,86,62,.05); }
.status-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.status-title { margin-top: 4rpx; font-size: 31rpx; font-weight: 600; }
.status-count { margin-top: 5rpx; color: var(--t-text-sub); font-size: 22rpx; }
.status-count text { color: var(--t-primary-deep); font-size: 32rpx; font-weight: 700; }
.meal-progress { display: flex; justify-content: space-between; margin: 26rpx 16rpx 20rpx; }
.meal-progress-item { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; }
.meal-progress-item:not(:last-child)::after { content: ''; position: absolute; top: 20rpx; left: 50%; width: 100%; height: 2rpx; background: #EDE4D2; z-index: 0; }
.meal-dot { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; border: 2rpx solid #E6DDCE; border-radius: 50%; background: var(--t-card); color: var(--t-card); font-size: 22rpx; }
.meal-dot-done { border-color: var(--t-primary); background: var(--t-primary); color: var(--t-primary-ink); }
.meal-label { margin-top: 8rpx; color: #A29B8B; font-size: 22rpx; }
.status-note { display: flex; align-items: center; padding: 14rpx 18rpx; border-radius: 14rpx; background: var(--t-bg); color: #8B754C; font-size: 22rpx; }
.note-spark { margin-right: 10rpx; color: #E8A31E; }

.section-tight { margin-top: 26rpx; }
.section-title { margin: 0 4rpx 16rpx; font-size: 31rpx; }
.section-link { color: var(--t-primary-deep); font-size: 23rpx; font-weight: 400; }
.recommend-card { display: flex; align-items: center; padding: 23rpx 24rpx; border: 1rpx solid #F0E1BF; border-radius: 22rpx; background: var(--t-card); box-shadow: 0 6rpx 16rpx rgba(96,86,62,.045); }
.recommend-icon { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; margin-right: 18rpx; border-radius: 20rpx; background: var(--t-chip); font-size: 36rpx; }
.recommend-body { flex: 1; min-width: 0; }
.recommend-title { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 27rpx; font-weight: 600; }
.recommend-sub { margin-top: 7rpx; color: var(--t-text-sub); font-size: 21rpx; }
.recommend-arrow { color: #D1A54C; font-size: 34rpx; }

.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.quick-item { display: grid; grid-template-columns: 54rpx 1fr; grid-template-rows: auto auto; align-items: center; min-height: 86rpx; padding: 16rpx 18rpx; border-radius: 20rpx; font-size: 25rpx; font-weight: 600; }
.quick-icon { grid-row: 1 / span 2; display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border-radius: 15rpx; font-size: 27rpx; }
.quick-caption { grid-column: 2; margin-top: 2rpx; color: #948C7C; font-size: 19rpx; font-weight: 400; }
.quick-item-yellow { background: #FFF3D5; color: #806523; }.quick-item-yellow .quick-icon { background: #FFE4A6; }
.quick-item-green { background: #EAF3E5; color: #55734E; }.quick-item-green .quick-icon { background: #D3E8CB; }
.quick-item-pink { background: #F8E9EB; color: #905968; }.quick-item-pink .quick-icon { background: #F2D2D8; }
.quick-item-blue { background: #E7F0F3; color: #54707A; }.quick-item-blue .quick-icon { background: #D3E5EA; }

.companion-card { display: flex; align-items: center; margin-top: 28rpx; padding: 19rpx 22rpx; border-radius: 22rpx; background: #3F4A3A; color: var(--t-card); box-shadow: 0 12rpx 22rpx rgba(63,74,58,.16); }
.companion-avatar { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-right: 16rpx; border-radius: 22rpx; background: #E0EEDB; font-size: 35rpx; }
.companion-body { flex: 1; min-width: 0; }.companion-title { font-size: 26rpx; font-weight: 600; }.companion-title text { margin-left: 7rpx; color: #C7D6BE; font-size: 20rpx; font-weight: 400; }.companion-text { margin-top: 5rpx; overflow: hidden; color: #D9E3D3; white-space: nowrap; text-overflow: ellipsis; font-size: 21rpx; }.companion-arrow { color: #C7D6BE; font-size: 38rpx; }
.today-section { margin-bottom: 28rpx; }
.home-empty { margin-top: 28rpx; }
.login-card { margin-top: 38rpx; }.login-mark { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin-bottom: 20rpx; border-radius: 24rpx; background: var(--t-primary); color: var(--t-primary-ink); font-size: 40rpx; font-weight: 700; }.login-copy { margin-top: -12rpx; margin-bottom: 22rpx; color: var(--t-text-sub); font-size: 23rpx; }.login-password { margin-top: 16rpx; }
/* ---------- 认领身份弹窗（第一次进入） ---------- */
.claim-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  background: rgba(60, 48, 28, .42);
}

.claim-modal {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: 72rpx 40rpx 40rpx;
  border-radius: 32rpx;
  background: var(--t-card);
  box-shadow: 0 24rpx 60rpx rgba(92, 67, 31, .28);
}

/* DongDong羊：圆形裁剪，坐在弹窗左上角 */
.claim-avatar {
  position: absolute;
  top: -56rpx;
  left: 40rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 6rpx solid var(--t-card);
  box-sizing: border-box;
  background: #FFE4A7;
  box-shadow: 0 8rpx 20rpx rgba(116, 91, 42, .2);
}

.claim-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--t-text-strong);
}

.claim-desc {
  margin: 12rpx 0 32rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--t-text-sub);
}

.claim-modal .btn { margin-top: 18rpx; }

.lulu-dock { position: fixed; right: 8rpx; bottom: 206rpx; z-index: 1001; width: 124rpx; height: 124rpx; display: flex; align-items: flex-end; justify-content: center; border-radius: 50%; pointer-events: auto; }
.lulu-dock-image { width: 116rpx; filter: drop-shadow(0 8rpx 8rpx rgba(100,75,27,.17)); }
.lulu-ping { position: absolute; top: 4rpx; right: 13rpx; width: 18rpx; height: 18rpx; border: 4rpx solid var(--t-bg); border-radius: 50%; background: #E77955; z-index: 2; }
.lulu-menu { position: fixed; right: 22rpx; bottom: 326rpx; z-index: 1000; width: 520rpx; padding: 24rpx; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.85); border-radius: 28rpx; background: rgba(255,253,247,.98); box-shadow: 0 20rpx 50rpx rgba(92,67,31,.22); opacity: 0; transform: translateY(18rpx) scale(.96); pointer-events: none; transition: all .18s ease; }
.lulu-menu-show { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
.lulu-menu-head { display: flex; justify-content: space-between; padding: 2rpx 4rpx 18rpx; }.menu-title { margin-top: 6rpx; font-size: 30rpx; font-weight: 600; }.menu-close { color: #BDB3A0; font-size: 38rpx; line-height: 1; }
.lulu-menu-item { display: flex; align-items: center; padding: 16rpx 8rpx; border-top: 1rpx solid #F2ECDF; }.menu-item-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-right: 14rpx; border-radius: 18rpx; background: #FFF4D7; font-size: 28rpx; }.menu-item-copy { flex: 1; font-size: 26rpx; font-weight: 500; }.menu-item-copy text { display: block; margin-top: 2rpx; color: #A49C8D; font-size: 20rpx; font-weight: 400; }.menu-item-arrow { color: #C7BDA8; font-size: 34rpx; }

.identity-arrow { margin-left: 8rpx; color: var(--t-primary-deep); font-size: 22rpx; }

/* ---------- 首页横幅（内容来自数据库 app_config） ---------- */
.daily-banner {
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, var(--t-grad-4) 0%, var(--t-primary) 100%);
  animation: bannerGlow 2.4s ease-in-out infinite;
}

/* 整体发光：外圈光晕 + 内部一层柔光，整块都在亮 */
@keyframes bannerGlow {
  0%, 100% {
    box-shadow:
      inset 0 2rpx 0 rgba(255, 255, 255, 0.45),
      inset 0 -18rpx 34rpx rgba(255, 255, 255, 0.14),
      0 0 20rpx var(--t-btn-glow),
      0 0 40rpx var(--t-btn-glow),
      0 8rpx 22rpx rgba(120, 80, 50, 0.18);
  }
  50% {
    box-shadow:
      inset 0 2rpx 0 rgba(255, 255, 255, 0.72),
      inset 0 -18rpx 40rpx rgba(255, 255, 255, 0.26),
      0 0 34rpx var(--t-btn-glow),
      0 0 72rpx var(--t-btn-glow),
      0 8rpx 22rpx rgba(120, 80, 50, 0.18);
  }
}

.daily-banner-img {
  display: block;
  width: 100%;
  height: 200rpx;
  background: var(--t-holder);
}

.daily-banner-text {
  padding: 30rpx 28rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 2rpx;
  text-align: center;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(150, 70, 20, 0.3);
}

