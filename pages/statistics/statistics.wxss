.seg {
  display: flex;
  background: var(--t-field);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: var(--t-text-mid);
  padding: 12rpx 0;
  border-radius: 999rpx;
}

.seg-active {
  background: var(--t-primary);
  color: var(--t-primary-ink);
  font-weight: 600;
}

.hero-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
}

.hero-main {
  display: flex;
  align-items: baseline;
}

.hero-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--t-primary-deep);
}

.hero-unit {
  font-size: 26rpx;
  color: var(--t-text-sub);
  margin-left: 10rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--t-text-sub);
}

.hero-divider {
  width: 100%;
  height: 1rpx;
  background: #F0EAD8;
  margin: 28rpx 0 22rpx;
}

.hero-metrics {
  display: flex;
  width: 100%;
}

.metric {
  flex: 1;
  text-align: center;
}

.metric-num {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--t-text);
}

.metric-label {
  display: block;
  font-size: 22rpx;
  color: var(--t-text-sub);
  margin-top: 4rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.bar-label {
  width: 100rpx;
  font-size: 25rpx;
  color: var(--t-text-mid);
}

.bar-track {
  flex: 1;
  height: 16rpx;
  background: var(--t-field);
  border-radius: 999rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFD76A, var(--t-primary));
}

.dim-fill {
  background: linear-gradient(90deg, #A8CEA0, #5B8C5A);
}

.bar-count {
  font-size: 24rpx;
  color: var(--t-text-sub);
  width: 70rpx;
  text-align: right;
}

.hint-dark {
  font-size: 22rpx;
  color: #B9B2A2;
  margin-top: 4rpx;
}

.overall-chips {
  display: flex;
  flex-wrap: wrap;
}

.overall-chip {
  font-size: 25rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  margin: 0 16rpx 12rpx 0;
}
