<view class="food-record-card" bindtap="onTap">
  <view class="head">
    <text class="time">{{timeText}}</text>
    <text class="meal">{{mealText}}</text>
    <view class="overall" wx:if="{{overallMeta.text}}" style="color: {{overallMeta.color}}; background: {{overallMeta.bg}};">{{overallMeta.text}}</view>
  </view>
  <view class="foods">{{foodsText}}</view>
  <view class="nutrition" wx:if="{{nutritionText}}">🔥 {{nutritionText}}</view>
  <view class="summary" wx:if="{{record.summary}}">{{record.summary}}</view>
</view>
