.food-record-card {
  background: #FFFDF7;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(96, 86, 62, 0.05);
}

.head {
  display: flex;
  align-items: center;
}

.time {
  font-size: 30rpx;
  font-weight: 600;
}

.meal {
  font-size: 24rpx;
  color: #9B968A;
  margin-left: 16rpx;
}

.overall {
  margin-left: auto;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.foods {
  margin-top: 14rpx;
  font-size: 28rpx;
}

.nutrition {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B57D0A;
}

.summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9B968A;
}
