.ingredient-item {
  display: flex;
  align-items: center;
  background: var(--t-card);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(96, 86, 62, 0.05);
}

.ingredient-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 18rpx;
  border-radius: 20rpx;
  background: #F0F6EA;
  font-size: 34rpx;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
}

.meta {
  font-size: 24rpx;
  color: var(--t-text-sub);
  margin-top: 4rpx;
}

.delete {
  margin-left: 14rpx;
  padding: 9rpx 18rpx;
  border: 1rpx solid #F1D8D1;
  border-radius: 999rpx;
  color: #B86B58;
  background: #FFF5F1;
  font-size: 22rpx;
}
