<view class="ingredient-item">
  <view class="ingredient-icon">🥕</view>
  <view class="info">
    <view class="name">{{ingredient.name}}</view>
    <view class="meta" wx:if="{{ingredient.quantity || ingredient.note}}">{{ingredient.quantity || ingredient.note}}</view>
  </view>
  <view class="delete" catchtap="onDelete">移除</view>
</view>
