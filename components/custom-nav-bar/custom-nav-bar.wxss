.nav-bar {
  background: #FFF6DE;
  margin: -32rpx -32rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(255, 182, 39, 0.16);
}

.nav-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  box-sizing: border-box;
  padding: 0 24rpx 0 32rpx;
}

.nav-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3F3D38;
  line-height: 1.2;
}

.nav-sub {
  font-size: 21rpx;
  color: #9B968A;
  margin-top: 2rpx;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
}

.nav-date {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #B57D0A;
  background: #FFF1CC;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin-right: 180rpx;
  line-height: 1.2;
}
