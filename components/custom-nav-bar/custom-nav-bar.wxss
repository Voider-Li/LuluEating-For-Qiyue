.nav-bar {
  background: #FFF6DE;
  margin: -32rpx -32rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(255, 182, 39, 0.16);
}

.nav-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  box-sizing: border-box;
  padding: 0 24rpx 0 32rpx;
}

/* ---------- 左侧：返回按钮 或 品牌 ---------- */
.nav-left-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.nav-back {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 10rpx 0 4rpx;
  border-radius: 20rpx;
  color: #8B6A35;
}

.nav-back-hover {
  background: rgba(255, 196, 83, 0.2);
}

.nav-back-icon {
  font-size: 48rpx;
  font-family: Arial, sans-serif;
  font-weight: 300;
  line-height: 0.8;
  transform: translateY(-2rpx);
}

.nav-back-text {
  margin-left: 2rpx;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1;
  white-space: nowrap;
}

.nav-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3F3D38;
  line-height: 1.2;
  white-space: nowrap;
}

.nav-sub {
  font-size: 18rpx;
  color: #9B968A;
  margin-top: 2rpx;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 右侧：祈栎专属 + 日期（同一行，高度一致，天然对齐） ---------- */
.nav-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  /* 给右上角的胶囊按钮留出位置 */
  margin-right: 168rpx;
}

.nav-tag,
.nav-date {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.nav-tag {
  position: relative;
  overflow: hidden;
  padding: 0 16rpx;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #FFF9EC;
  background: linear-gradient(120deg, #F0A80F 0%, #D97D0A 55%, #C96F05 100%);
  box-shadow: 0 0 12rpx rgba(217, 125, 10, 0.5);
  animation: tagGlow 2.2s ease-in-out infinite;
}

.nav-tag::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 40%;
  left: -60%;
  background: linear-gradient(105deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.5) 50%, rgba(255, 255, 255, 0) 100%);
  animation: tagShine 2.6s ease-in-out infinite;
}

@keyframes tagGlow {
  0%, 100% {
    box-shadow: 0 0 10rpx rgba(217, 125, 10, 0.4), 0 0 20rpx rgba(255, 182, 39, 0.2);
  }
  50% {
    box-shadow: 0 0 18rpx rgba(217, 125, 10, 0.7), 0 0 34rpx rgba(255, 182, 39, 0.45);
  }
}

@keyframes tagShine {
  0% {
    left: -60%;
  }
  45%, 100% {
    left: 130%;
  }
}

.nav-date {
  padding: 0 18rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #B57D0A;
  background: #FFF1CC;
}
