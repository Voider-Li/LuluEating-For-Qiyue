/* ============================================================
   主题变量（唯一来源）
   app.wxss 和 custom-tab-bar/index.wxss 都 @import 这个文件，
   保证两边颜色永远一致。

   为什么 TabBar 要单独 import：
   自定义 tabBar 是框架单独渲染的，不在页面节点树里，
   拿不到页面上的 CSS 变量（会解析成空值 → 整条 background 失效 → 变透明）。

   换主题：改 app_config 的 birthday_mode（或 theme）即可。
   加第三套：下面复制一组 .theme-xxx。
   ============================================================ */

/* ---------- 暖色（默认） ---------- */
page,
.theme-warm {
  --t-bg: #FFF6DE;
  --t-card: #FFFDF7;
  --t-chip: #FFF1CC;
  --t-field: #F4F1E9;
  --t-holder: #F0E6D2;

  --t-primary: #FFB627;
  --t-primary-deep: #B57D0A;
  --t-primary-ink: #5C4305;
  --t-primary-soft: #8B6A35;
  --t-accent: #B7A36D;

  --t-text: #3F3D38;
  --t-text-strong: #413D35;
  --t-text-sub: #9B968A;
  --t-text-mid: #7A756A;
  --t-text-soft: #A79C86;
  --t-text-body: #4D473C;

  --t-grad-1: #F0A80F;
  --t-grad-2: #D97D0A;
  --t-grad-3: #C96F05;
  --t-grad-4: #FFC94F;
  --t-grad-5: #F5A312;

  /* 页面底部环境光：只做很淡的一层，别把 Dock 底下的颜色染黄 */
  --t-glow-a: rgba(255, 182, 39, 0.09);
  --t-glow-b: rgba(255, 182, 39, 0.14);
  --t-btn-glow: rgba(245, 163, 18, 0.5);

  /* 液态玻璃 Dock：玻璃体压得很淡，靠 blur + 边光撑起来 */
  --t-glass-top: rgba(255, 255, 255, 0.30);
  --t-glass-mid: rgba(255, 255, 255, 0.12);
  --t-glass-bot: rgba(255, 249, 238, 0.22);
  --t-glass-edge: rgba(255, 255, 255, 0.52);
  --t-glass-warm: rgba(255, 205, 120, 0.16);
  --t-glass-shade: rgba(126, 98, 46, 0.10);
  --t-glass-shadow-1: rgba(94, 72, 26, 0.26);
  --t-glass-shadow-2: rgba(94, 72, 26, 0.09);
  --t-glass-tint: rgba(255, 214, 130, 0.16);
}

/* ---------- 粉色 ---------- */
.theme-pink {
  --t-bg: #FFF1F6;
  --t-card: #FFF9FB;
  --t-chip: #FFE3EE;
  --t-field: #F9EFF4;
  --t-holder: #F7E6EE;

  --t-primary: #FF9BC0;
  --t-primary-deep: #C2527E;
  --t-primary-ink: #6B2445;
  --t-primary-soft: #A8577C;
  --t-accent: #C98FA8;

  --t-text: #43333B;
  --t-text-strong: #452F38;
  --t-text-sub: #A98D9A;
  --t-text-mid: #8A7280;
  --t-text-soft: #B79DA9;
  --t-text-body: #4E3B45;

  --t-grad-1: #FFA8C8;
  --t-grad-2: #E06A9B;
  --t-grad-3: #D15C8D;
  --t-grad-4: #FFB3CF;
  --t-grad-5: #EE7BA6;

  --t-glow-a: rgba(255, 155, 192, 0.10);
  --t-glow-b: rgba(255, 155, 192, 0.16);
  --t-btn-glow: rgba(255, 122, 172, 0.62);

  /* 液态玻璃 Dock：粉色主题下反光偏玫瑰 */
  --t-glass-top: rgba(255, 255, 255, 0.32);
  --t-glass-mid: rgba(255, 255, 255, 0.12);
  --t-glass-bot: rgba(255, 243, 248, 0.24);
  --t-glass-edge: rgba(255, 255, 255, 0.55);
  --t-glass-warm: rgba(255, 168, 200, 0.18);
  --t-glass-shade: rgba(128, 66, 92, 0.10);
  --t-glass-shadow-1: rgba(112, 52, 78, 0.24);
  --t-glass-shadow-2: rgba(112, 52, 78, 0.09);
  --t-glass-tint: rgba(255, 168, 200, 0.18);
}
