.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(constant(safe-area-inset-bottom) + 30rpx);
  bottom: calc(env(safe-area-inset-bottom) + 30rpx);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx 12rpx 12rpx;
  height: 132rpx;
  box-sizing: border-box;
  border-radius: 48rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  background:
    radial-gradient(rgba(255, 255, 255, 0.9) 1rpx, transparent 1.5rpx),
    linear-gradient(165deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 249, 238, 0.58) 55%, rgba(255, 246, 222, 0.5) 100%);
  background-size: 8rpx 8rpx, 100% 100%;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -10rpx 28rpx rgba(255, 182, 39, 0.07),
    0 20rpx 48rpx rgba(96, 86, 62, 0.22),
    0 4rpx 12rpx rgba(96, 86, 62, 0.08);
  -webkit-backdrop-filter: blur(48rpx);
  backdrop-filter: blur(48rpx);
  -webkit-backdrop-filter: blur(48rpx) saturate(1.5);
  backdrop-filter: blur(48rpx) saturate(1.5);
}

.tab-group {
  width: 470rpx;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 8rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.22));
}

.tab-item {
  flex: 1;
  height: 100%;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #9B968A;
}

.tab-item-active .tab-text {
  color: #B57D0A;
  font-weight: 600;
}

.tab-item-active {
  background: linear-gradient(180deg, rgba(255, 182, 39, 0.22), rgba(255, 182, 39, 0.1));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.tab-side {
  width: 148rpx;
  display: flex;
  justify-content: center;
}

.chat-btn {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #FFC94F 0%, #FFB627 55%, #F5A312 100%);
  box-shadow:
    0 10rpx 24rpx rgba(245, 163, 18, 0.38),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.65);
  transition: transform 0.15s ease;
}

.chat-btn-hover {
  transform: scale(0.94);
}

.chat-icon {
  width: 42rpx;
  height: 42rpx;
}

.chat-label {
  margin-top: 2rpx;
  font-size: 18rpx;
  line-height: 1.1;
  color: #5C4305;
  font-weight: 600;
}
