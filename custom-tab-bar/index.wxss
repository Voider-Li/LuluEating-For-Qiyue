/* 自定义 tabBar 不在页面节点树里，拿不到页面上的 CSS 变量，
   所以这里也 import 一份主题变量（唯一来源，跟 app.wxss 一致） */
@import "../styles/theme.wxss";

.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(constant(safe-area-inset-bottom) + 18rpx);
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx 12rpx 12rpx;
  height: 132rpx;
  box-sizing: border-box;
  border-radius: 48rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  background:
    radial-gradient(rgba(255, 255, 255, 0.9) 1rpx, transparent 1.5rpx),
    linear-gradient(165deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 249, 238, 0.58) 55%, rgba(255, 246, 222, 0.5) 100%);
  background-size: 8rpx 8rpx, 100% 100%;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -10rpx 28rpx rgba(255, 182, 39, 0.07),
    0 20rpx 48rpx rgba(96, 86, 62, 0.22),
    0 4rpx 12rpx rgba(96, 86, 62, 0.08);
  -webkit-backdrop-filter: blur(48rpx);
  backdrop-filter: blur(48rpx);
  -webkit-backdrop-filter: blur(48rpx) saturate(1.5);
  backdrop-filter: blur(48rpx) saturate(1.5);
}

.tab-group {
  width: 470rpx;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 8rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.22));
}

.tab-item {
  flex: 1;
  height: 100%;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1;
  color: var(--t-text-sub);
}

.tab-item-active .tab-text {
  color: var(--t-primary-deep);
  font-weight: 600;
}

.tab-item-active {
  background: linear-gradient(180deg, var(--t-glow-b), var(--t-glow-a));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.tab-side {
  width: 148rpx;
  display: flex;
  justify-content: center;
}

.chat-btn {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, var(--t-grad-4) 0%, var(--t-primary) 55%, var(--t-grad-5) 100%);
  box-shadow:
    0 0 22rpx var(--t-btn-glow),
    0 10rpx 24rpx var(--t-btn-glow),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.65);
  animation: chatGlow 2.4s ease-in-out infinite;
  transition: transform 0.15s ease;
}

/* 呼吸式的光晕：暖色主题是暖光，粉色主题是粉光 */
@keyframes chatGlow {
  0%, 100% {
    box-shadow:
      0 0 16rpx var(--t-btn-glow),
      0 8rpx 20rpx rgba(0, 0, 0, 0.16),
      inset 0 2rpx 0 rgba(255, 255, 255, 0.65);
  }
  50% {
    box-shadow:
      0 0 38rpx var(--t-btn-glow),
      0 12rpx 28rpx rgba(0, 0, 0, 0.2),
      inset 0 2rpx 0 rgba(255, 255, 255, 0.78);
  }
}

.chat-btn-hover {
  transform: scale(0.94);
}

.chat-icon {
  width: 42rpx;
  height: 42rpx;
}

.chat-label {
  margin-top: 2rpx;
  font-size: 18rpx;
  line-height: 1.1;
  color: var(--t-primary-ink);
  font-weight: 600;
}
