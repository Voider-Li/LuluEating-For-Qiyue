/* 自定义 tabBar 不在页面节点树里，拿不到页面上的 CSS 变量，
   所以这里也 import 一份主题变量（唯一来源，跟 app.wxss 一致） */
@import "../styles/theme.wxss";

/* ============================================================
   液态玻璃 Dock（Liquid Glass）
   小程序里没有 SVG 位移滤镜，所以"折射"靠这几层叠出来：
     1. 极淡的玻璃体：透明度压到 0.1~0.4，让底下的内容透上来
     2. backdrop-filter: blur + saturate + brightness（糊开并提亮）
     3. 四边内发光：上缘最亮、下缘反光，做出"玻璃厚度"
     4. 顶部弧形高光 + 缓慢横穿的液态反光（.tab-glass 里跑）
     5. 外投影把整块玻璃托起来
   任何一层不支持（老安卓没 backdrop-filter），剩下的半透明底也不至于糊成一片。
   ============================================================ */

.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(constant(safe-area-inset-bottom) + 20rpx);
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 999;
  display: flex;
  align-items: center;
  height: 128rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border-radius: 46rpx;
  border: 1rpx solid var(--t-glass-edge);
  background: linear-gradient(
    172deg,
    var(--t-glass-top) 0%,
    var(--t-glass-mid) 44%,
    var(--t-glass-bot) 100%
  );
  -webkit-backdrop-filter: blur(22px) saturate(190%) brightness(1.06);
  backdrop-filter: blur(22px) saturate(190%) brightness(1.06);
  box-shadow:
    /* 玻璃厚度：上缘亮、下缘反光、左右各一道边光 */
    inset 0 2rpx 0 rgba(255, 255, 255, 0.98),
    inset 0 -2rpx 1rpx rgba(255, 255, 255, 0.55),
    inset 2rpx 0 0 rgba(255, 255, 255, 0.5),
    inset -2rpx 0 0 rgba(255, 255, 255, 0.5),
    /* 顶部弧面 + 底部透上来的暖色 */
    inset 0 26rpx 28rpx -24rpx rgba(255, 255, 255, 0.9),
    inset 0 -30rpx 34rpx -28rpx var(--t-glass-warm),
    /* 浮起来 */
    0 20rpx 40rpx -14rpx var(--t-glass-shadow-1),
    0 3rpx 10rpx var(--t-glass-shadow-2);
}

/* ---------- 玻璃层：只负责光，不挡点击 ---------- */
.tab-glass {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  border-radius: inherit;
  overflow: hidden;
  pointer-events: none;
}

/* 顶部弧形高光：像液面被压出来的那道亮边 */
.tab-glass::before {
  content: '';
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  top: 0;
  height: 58rpx;
  border-radius: 44rpx 44rpx 72% 72%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 255, 255, 0) 82%);
}

/* 液态反光：一条斜向的高光带，每隔几秒慢慢淌过去 */
.tab-glass::after {
  content: '';
  position: absolute;
  top: -70%;
  bottom: -70%;
  left: -42%;
  width: 54%;
  background: linear-gradient(
    100deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.5) 42%,
    rgba(255, 255, 255, 0.86) 50%,
    rgba(255, 255, 255, 0.5) 58%,
    rgba(255, 255, 255, 0) 100%
  );
  filter: blur(10rpx);
  transform: rotate(6deg) translateX(-40%);
  animation: glassFlow 7.5s cubic-bezier(0.45, 0, 0.55, 1) infinite;
}

@keyframes glassFlow {
  0%, 6% {
    transform: rotate(6deg) translateX(-40%);
    opacity: 0;
  }
  16% {
    opacity: 0.85;
  }
  52% {
    opacity: 0.5;
  }
  68%, 100% {
    transform: rotate(6deg) translateX(300%);
    opacity: 0;
  }
}

/* ---------- 左侧三个 tab ---------- */
.tab-group {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 8rpx;
  border-radius: 38rpx;
  border: 1rpx solid var(--t-glass-inner);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.26), rgba(255, 255, 255, 0.06));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

/* 液态药丸：宽度 = 单个 tab，位移 = n 个自身宽度；带回弹，像水滴被推过去 */
.tab-indicator {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  width: calc((100% - 16rpx) / 3);
  border-radius: 30rpx;
  background: radial-gradient(
    130% 90% at 50% 0%,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(255, 255, 255, 0.74) 46%,
    rgba(255, 255, 255, 0.56) 100%
  );
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 1),
    inset 0 -10rpx 14rpx -8rpx rgba(255, 255, 255, 0.8),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.65),
    0 8rpx 16rpx -6rpx var(--t-glass-shadow-2);
  transition: transform 0.52s cubic-bezier(0.34, 1.26, 0.64, 1);
}

/* 药丸左上角的一点镜面高光 */
.tab-indicator::after {
  content: '';
  position: absolute;
  left: 22%;
  top: 12%;
  width: 30rpx;
  height: 12rpx;
  border-radius: 50%;
  background: radial-gradient(rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0));
  filter: blur(2rpx);
}

.tab-indicator-0 {
  transform: translateX(0);
}

.tab-indicator-1 {
  transform: translateX(100%);
}

.tab-indicator-2 {
  transform: translateX(200%);
}

.tab-item {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  transition: transform 0.18s ease;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-icon {
  width: 46rpx;
  height: 46rpx;
  transition: transform 0.28s cubic-bezier(0.34, 1.26, 0.64, 1);
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 0.5rpx;
  color: var(--t-text-sub);
  transition: color 0.2s ease;
}

.tab-item-active .tab-text {
  color: var(--t-primary-deep);
  font-weight: 600;
}

.tab-item-active .tab-icon {
  transform: translateY(-2rpx) scale(1.08);
}

/* ---------- 右侧：嘎哒（AI 聊天） ---------- */
.tab-side {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  margin-left: 10rpx;
  padding-right: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-btn {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, var(--t-grad-4) 0%, var(--t-primary) 55%, var(--t-grad-5) 100%);
  box-shadow:
    0 0 16rpx var(--t-btn-glow),
    0 8rpx 18rpx var(--t-glass-shadow-2),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.75),
    inset 0 -8rpx 12rpx -8rpx rgba(255, 255, 255, 0.5);
  animation: chatGlow 2.8s ease-in-out infinite;
  transition: transform 0.16s ease;
}

/* 球面上的镜面弧 */
.chat-btn::after {
  content: '';
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 6rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0));
  pointer-events: none;
}

@keyframes chatGlow {
  0%, 100% {
    box-shadow:
      0 0 12rpx var(--t-btn-glow),
      0 8rpx 16rpx var(--t-glass-shadow-2),
      inset 0 2rpx 0 rgba(255, 255, 255, 0.7),
      inset 0 -8rpx 12rpx -8rpx rgba(255, 255, 255, 0.5);
  }
  50% {
    box-shadow:
      0 0 30rpx var(--t-btn-glow),
      0 12rpx 24rpx var(--t-glass-shadow-1),
      inset 0 2rpx 0 rgba(255, 255, 255, 0.85),
      inset 0 -8rpx 12rpx -8rpx rgba(255, 255, 255, 0.5);
  }
}

.chat-btn-hover {
  transform: scale(0.94);
}

.chat-icon {
  position: relative;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
}

.chat-label {
  position: relative;
  z-index: 1;
  margin-top: 2rpx;
  font-size: 18rpx;
  line-height: 1.1;
  color: var(--t-primary-ink);
  font-weight: 600;
}
