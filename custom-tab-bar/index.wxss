/* 自定义 tabBar 不在页面节点树里，拿不到页面上的 CSS 变量，
   所以这里也 import 一份主题变量（唯一来源，跟 app.wxss 一致） */
@import "../styles/theme.wxss";

/* ============================================================
   液态玻璃 Dock
   ------------------------------------------------------------
   结构（各层只管一件事，互不打架）：
     .tab-bar    容器：玻璃体底色 + 边缘光 + 投影
     .tab-glass  纯光效层：顶部弧光、缓慢流动的反光
     .tab-group  导航区：选中底座 + 3 个 tab
     .tab-side   右侧嘎哒入口
   ------------------------------------------------------------
   微信小程序没有 SVG 位移滤镜，做不出真实折射，这里用四件事逼近：
     1. 低不透明度玻璃体（0.12~0.30），让页面底色真正透上来
     2. backdrop-filter: blur(24px) + saturate(150%) + brightness(1.03)
     3. 边缘光：上缘细高光、左右边光、下缘微弱暗部（玻璃厚度）
     4. 内部光学层次：左上角柔光 + 右下角暖色透光 + 缓慢流动的反光
   所有效果都克制：没有大面积纯白、没有彩虹色、没有强发光。
   ============================================================ */

.tab-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(constant(safe-area-inset-bottom) + 24rpx);
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  z-index: 999;
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border-radius: 60rpx;
  /* 描边是"淡光边"，不是纯白框 */
  border: 1rpx solid var(--t-glass-edge);
  /* 三层底：左上柔光 / 右下暖光 / 竖向明暗渐变 */
  background:
    radial-gradient(78% 120% at 12% -20%, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0) 64%),
    radial-gradient(70% 130% at 104% 116%, var(--t-glass-warm) 0%, rgba(255, 255, 255, 0) 58%),
    linear-gradient(
      172deg,
      var(--t-glass-top) 0%,
      var(--t-glass-mid) 46%,
      var(--t-glass-bot) 100%
    );
  -webkit-backdrop-filter: blur(24px) saturate(150%) brightness(1.03);
  backdrop-filter: blur(24px) saturate(150%) brightness(1.03);
  box-shadow:
    /* 上缘一道细高光 */
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92),
    /* 左右边光 */
    inset 2rpx 0 0 rgba(255, 255, 255, 0.34),
    inset -2rpx 0 0 rgba(255, 255, 255, 0.34),
    /* 下缘：先一道反光，再一层极淡暗部，做出厚度 */
    inset 0 -1rpx 1rpx rgba(255, 255, 255, 0.42),
    inset 0 -16rpx 20rpx -16rpx var(--t-glass-shade),
    /* 悬浮投影：近处实、远处散 */
    0 16rpx 36rpx -12rpx var(--t-glass-shadow-1),
    0 4rpx 12rpx var(--t-glass-shadow-2);
}

/* ---------- 光效层：只负责光，不挡点击 ---------- */
.tab-glass {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  border-radius: inherit;
  overflow: hidden;
  pointer-events: none;
}

/* 顶部弧面高光：模拟玻璃被环境光压出来的亮边 */
.tab-glass::before {
  content: '';
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 0;
  height: 44rpx;
  border-radius: 56rpx 56rpx 70% 70%;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.42) 0%,
    rgba(255, 255, 255, 0.12) 44%,
    rgba(255, 255, 255, 0) 100%
  );
}

/* 缓慢流动的一道反光：12s 一轮，最大不透明度只有 0.4，够"液态"但不抢戏
   用渐变自身做柔边，不用 filter: blur()，省性能 */
.tab-glass::after {
  content: '';
  position: absolute;
  top: -60%;
  bottom: -60%;
  left: -46%;
  width: 46%;
  background: linear-gradient(
    100deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.22) 34%,
    rgba(255, 255, 255, 0.40) 50%,
    rgba(255, 255, 255, 0.22) 66%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: rotate(6deg) translateX(-40%);
  will-change: transform, opacity;
  animation: glassFlow 12s cubic-bezier(0.45, 0, 0.55, 1) infinite;
}

@keyframes glassFlow {
  0%, 8% {
    transform: rotate(6deg) translateX(-40%);
    opacity: 0;
  }
  18% {
    opacity: 0.9;
  }
  54% {
    opacity: 0.45;
  }
  72%, 100% {
    transform: rotate(6deg) translateX(320%);
    opacity: 0;
  }
}

/* ---------- 左侧导航区 ---------- */
.tab-group {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 6rpx;
  border-radius: 50rpx;
  /* 导航区不再套一层"卡片"，整块 Dock 是一块完整的玻璃 */
  background: transparent;
}

/* 选中底座：半透明玻璃胶囊，不是实心白块
   宽度 = 单个 tab，位移 = n 个自身宽度 */
.tab-indicator {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  width: calc((100% - 12rpx) / 3);
  border-radius: 44rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  background:
    radial-gradient(120% 100% at 50% -10%, rgba(255, 255, 255, 0.62) 0%, rgba(255, 255, 255, 0.30) 62%, rgba(255, 255, 255, 0.24) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.26), rgba(255, 255, 255, 0.12));
  -webkit-backdrop-filter: blur(6px) saturate(140%);
  backdrop-filter: blur(6px) saturate(140%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96),
    inset 0 -10rpx 14rpx -10rpx rgba(255, 255, 255, 0.7),
    0 6rpx 14rpx -8rpx var(--t-glass-shadow-2);
  /* 缓入缓出、无回弹：克制，不抖 */
  transition: transform 0.42s cubic-bezier(0.32, 0.72, 0, 1);
}

.tab-indicator-0 {
  transform: translateX(0);
}

/* 首屏直接落位，不播滑动动画 */
.tab-indicator-static {
  transition: none;
}

.tab-indicator-1 {
  transform: translateX(100%);
}

.tab-indicator-2 {
  transform: translateX(200%);
}

.tab-item {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  transition: transform 0.16s ease, opacity 0.16s ease;
}

/* 按压反馈走 hover-class，比 :active 在安卓上稳 */
.tab-item-hover {
  transform: scale(0.96);
  opacity: 0.86;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.82;
  transition: transform 0.26s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.2s ease;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 0.4rpx;
  color: var(--t-text-sub);
  transition: color 0.2s ease;
}

.tab-item-active .tab-icon {
  opacity: 1;
  transform: scale(1.06);
}

.tab-item-active .tab-text {
  color: var(--t-primary-deep);
  font-weight: 600;
}

/* ---------- 右侧：嘎哒（AI 聊天） ---------- */
.tab-side {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  margin-left: 8rpx;
  padding-right: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-btn {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, var(--t-grad-4) 0%, var(--t-primary) 58%, var(--t-grad-5) 100%);
  box-shadow:
    0 6rpx 14rpx -6rpx var(--t-btn-glow),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.7),
    inset 0 -8rpx 12rpx -8rpx rgba(255, 255, 255, 0.42);
  transition: transform 0.16s ease;
}

/* 球面镜面弧：让圆球也是"玻璃球"，不是塑料球 */
.chat-btn::after {
  content: '';
  position: absolute;
  left: 11rpx;
  right: 11rpx;
  top: 5rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.52), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.chat-btn-hover {
  transform: scale(0.95);
}

.chat-icon {
  position: relative;
  z-index: 1;
  width: 38rpx;
  height: 38rpx;
}

.chat-label {
  position: relative;
  z-index: 1;
  margin-top: 1rpx;
  font-size: 17rpx;
  line-height: 1.1;
  color: var(--t-primary-ink);
  font-weight: 600;
}
