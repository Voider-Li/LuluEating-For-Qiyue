<view class="tab-bar theme-{{theme}}">
  <!-- 玻璃层：顶部弧光 + 缓慢流动的反光，overflow 裁出胶囊圆角 -->
  <view class="tab-glass"></view>

  <view class="tab-group">
    <view class="tab-indicator tab-indicator-{{selected}} {{animate ? '' : 'tab-indicator-static'}}"></view>
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'tab-item-active' : ''}}"
      hover-class="tab-item-hover"
      hover-stay-time="80"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <image class="tab-icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" />
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>

  <view class="tab-side">
    <view class="chat-btn" hover-class="chat-btn-hover" hover-stay-time="80" bindtap="goChat">
      <image class="chat-icon" src="/assets/tabbar/chat.png" />
      <text class="chat-label">嘎哒</text>
    </view>
  </view>
</view>
